---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface ServiceIcon {
  [key: string]: string;
}

const icons: ServiceIcon = {
  broom: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.368 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
  grass: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
  snowflake: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
  trash: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>`,
  wrench: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  check: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`,
  briefcase: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`,
};

const images = [
  "https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=800&h=1000&fit=crop&crop=center",
  "https://images.unsplash.com/photo-1558904541-efa843a96f01?w=600&h=700&fit=crop&crop=center",
  "https://images.unsplash.com/photo-1491002052546-bf38f186af56?w=600&h=480&fit=crop&crop=center",
  "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=600&fit=crop&crop=center",
  "https://images.unsplash.com/photo-1581244273943-6bb5a7d5e4f5?w=600&h=520&fit=crop&crop=center",
  "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=700&h=500&fit=crop&crop=center",
  "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=700&fit=crop&crop=center",
];

const services = t.services.items;

const layout = [
  { cols: "lg:col-span-2", rows: "lg:row-span-2", size: "featured" },
  { cols: "lg:col-span-1", rows: "lg:row-span-1", size: "standard" },
  { cols: "lg:col-span-1", rows: "lg:row-span-1", size: "standard" },
  { cols: "lg:col-span-1", rows: "lg:row-span-1", size: "tall" },
  { cols: "lg:col-span-1", rows: "lg:row-span-1", size: "standard" },
  { cols: "lg:col-span-2", rows: "lg:row-span-1", size: "wide" },
  { cols: "lg:col-span-1", rows: "lg:row-span-1", size: "standard" },
];
---

<section id="services" class="relative py-16 md:py-20 lg:py-24 bg-cream overflow-hidden noise-overlay">
  <div class="absolute top-0 left-0 right-0 h-48 bg-gradient-to-b from-white to-transparent pointer-events-none"></div>
  <div class="absolute -top-40 -right-40 w-80 h-80 bg-emerald/[0.03] rounded-full blur-[120px]"></div>
  <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-gold/[0.03] rounded-full blur-[120px]"></div>
  <div class="absolute top-1/2 right-[5%] w-48 h-48 bg-gold/[0.02] rounded-full blur-[100px] animate-float-slow"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto mb-10 md:mb-12 lg:mb-14 text-left lg:text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-forest/5 text-forest/80 rounded-full border border-forest/10 mb-6">
        <span class="w-1 h-1 bg-gold rounded-full"></span>
        <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">{t.services.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-semibold text-charcoal leading-[0.92] tracking-tight mb-4">
        {t.services.title}
      </h2>
      <p class="text-sm sm:text-base text-muted/70 font-body font-light leading-relaxed max-w-md">
        {t.services.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 lg:gap-6 auto-rows-[200px] md:auto-rows-[220px] lg:auto-rows-[240px]">
      {services.map((service, index) => {
        const l = layout[index];
        const isFeatured = l.size === "featured";
        const isWide = l.size === "wide";
        const isTall = l.size === "tall";
        const rowSpan = isFeatured ? "md:row-span-2 md:min-h-[380px] lg:min-h-[460px]" : isTall ? "md:row-span-2" : "";
        const colSpan = l.cols;
        return (
          <div
            class={`group relative overflow-hidden rounded-[32px] transition-all duration-700 inset-shadow-lg ${colSpan} ${rowSpan} ${isFeatured ? "md:col-span-2" : ""} ${isWide ? "md:col-span-2" : ""}`}
          >
            <div class="absolute inset-0">
              <img
                src={images[index]}
                alt=""
                class="w-full h-full object-cover transition-all duration-700 group-hover:scale-110"
                loading="lazy"
              />
            </div>

            <div class="absolute inset-0 bg-gradient-to-t from-forest/85 via-forest/20 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-br from-emerald/[0.08] to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700"></div>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-all duration-700 shadow-[inset_0_0_60px_rgba(194,164,109,0.06)]"></div>

            <div class={`absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-gold/60 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700 translate-x-[-100%] group-hover:translate-x-[100%]`}></div>

            <div class="relative z-10 flex flex-col justify-end h-full p-4 md:p-5 lg:p-6">
              <div class={`flex items-center justify-between mb-${isFeatured ? "5" : "3"}`}>
                <div class="w-9 h-9 md:w-10 md:h-10 bg-white/10 backdrop-blur-xl rounded-xl flex items-center justify-center text-gold border border-white/10 group-hover:bg-gold group-hover:text-forest group-hover:border-gold/30 transition-all duration-500 shadow-lg group-hover:shadow-gold/20">
                  <Fragment set:html={icons[service.icon]} />
                </div>
                <span class="text-[9px] font-body font-medium text-white/20 tracking-[0.2em] select-none">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>

              <div class="space-y-1.5">
                <h3 class={`font-heading font-medium text-white leading-[0.95] tracking-tight ${isFeatured ? "text-lg md:text-xl lg:text-2xl" : "text-base md:text-lg"}`}>
                  {service.title}
                </h3>
                <p class="text-white/40 font-body font-light leading-relaxed text-xs max-w-xs">
                  {service.description}
                </p>
              </div>

              <div class={`flex items-center gap-1.5 text-gold/80 font-body font-medium text-xs transition-all duration-500 ${
                isFeatured ? "mt-3 opacity-100" : "mt-1 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0"
              }`}>
                <span class="text-[10px] tracking-wider uppercase">{lang === 'de' ? 'Mehr erfahren' : 'Discover'}</span>
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>

            <div class="absolute top-4 right-4 z-10">
              <div class="backdrop-blur-xl bg-white/5 border border-white/5 rounded-full px-3 py-1 text-[9px] font-body font-medium text-white/30 tracking-[0.15em] uppercase opacity-0 group-hover:opacity-100 transition-all duration-500">
                Premium
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
