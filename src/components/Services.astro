---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface ServiceIcon {
  [key: string]: string;
}

const icons: ServiceIcon = {
  broom: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.368 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
  grass: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
  snowflake: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
  trash: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>`,
  wrench: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  check: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>`,
  briefcase: `<svg class="w-[26px] h-[26px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`,
};
---

<section id="services" class="relative py-20 md:py-28 lg:py-36 bg-white">
  <div class="absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-bg to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
    <div class="text-center max-w-3xl mx-auto mb-14 md:mb-18 lg:mb-22">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/8 text-primary rounded-full border border-primary/10 mb-6">
        <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
        <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase">{t.services.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-text leading-[1.1] tracking-tight mb-4">
        {t.services.title}
      </h2>
      <p class="text-base sm:text-lg text-muted/80 leading-relaxed max-w-xl mx-auto">
        {t.services.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6 lg:gap-7">
      {t.services.items.map((service, index) => (
        <div
          class="group relative bg-gradient-to-b from-white to-bg/30 border border-gray-100 rounded-2xl p-7 md:p-8 hover:border-primary/20 transition-all duration-500 hover-lift card-shine"
        >
          <div class="absolute top-0 left-6 right-6 h-[2px] bg-gradient-to-r from-primary/40 via-accent/40 to-primary/40 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-500 scale-x-0 group-hover:scale-x-100"></div>

          <div class="w-14 h-14 mb-5 bg-gradient-to-br from-primary/8 to-accent/8 group-hover:from-primary group-hover:to-accent rounded-2xl flex items-center justify-center text-primary group-hover:text-white transition-all duration-500 shadow-sm group-hover:shadow-lg">
            <Fragment set:html={icons[service.icon]} />
          </div>

          <h3 class="text-base md:text-lg font-heading font-bold text-text mb-3 group-hover:text-primary transition-colors duration-300 leading-snug tracking-tight">
            {service.title}
          </h3>

          <p class="text-sm md:text-[15px] text-muted/80 leading-relaxed">
            {service.description}
          </p>

          <div class="mt-5 flex items-center gap-1.5 text-primary font-semibold text-[13px] opacity-0 group-hover:opacity-100 transition-all duration-400 translate-y-1 group-hover:translate-y-0">
            <span>Mehr erfahren</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
