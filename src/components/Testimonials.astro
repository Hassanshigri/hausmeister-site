---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="testimonials" class="relative py-16 md:py-20 lg:py-24 bg-cream overflow-hidden">
  <div class="absolute top-0 right-0 w-80 h-80 bg-emerald/[0.03] rounded-full blur-[120px]"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-gold/[0.03] rounded-full blur-[120px]"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto mb-12 md:mb-14 lg:mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-forest/5 text-forest/80 rounded-full border border-forest/10 mb-8">
        <span class="w-1 h-1 bg-gold rounded-full"></span>
        <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">{t.testimonials.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-semibold text-charcoal leading-[0.92] tracking-tight mb-5">
        {t.testimonials.title}
      </h2>
      <p class="text-sm sm:text-base text-muted/70 font-body font-light leading-relaxed max-w-lg mx-auto tracking-wide">
        {t.testimonials.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {t.testimonials.items.map((item) => (
        <div class="rounded-3xl p-6 md:p-8 border border-white/20 hover:border-gold/30 hover:shadow-[0_0_40px_rgba(194,164,109,0.1)] transition-all duration-500 hover:-translate-y-1 bg-gradient-to-br from-forest to-emerald/90">
          <div class="flex gap-1 mb-4">
            <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
          </div>
          <p class="text-white/60 text-sm md:text-base font-body font-light leading-relaxed mb-6 tracking-wide">
            &ldquo;{item.text}&rdquo;
          </p>
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-gold/20 border border-gold/20 flex items-center justify-center text-gold font-heading font-medium text-sm">
              {item.name.charAt(0)}
            </div>
            <div>
              <p class="text-white font-heading font-medium text-sm tracking-wide">{item.name}</p>
              <p class="text-white/30 text-xs font-body tracking-wide">{item.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
