---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-white relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-forest/20 via-dark to-dark pointer-events-none"></div>
  <div class="absolute top-0 left-1/3 right-0 h-full bg-gradient-to-l from-emerald/[0.03] to-transparent pointer-events-none"></div>
  <div class="absolute top-10 right-[15%] w-96 h-96 bg-gold/[0.04] rounded-full blur-[150px] animate-float-slow"></div>
  <div class="absolute bottom-20 left-[10%] w-64 h-64 bg-emerald/[0.03] rounded-full blur-[120px] animate-float" style="animation-delay: 3s;"></div>
  <div class="absolute top-1/3 left-[5%] w-3 h-3 border border-gold/15 rounded-full animate-float" style="animation-delay: 1s;"></div>
  <div class="absolute bottom-1/3 right-[8%] w-2 h-2 bg-gold/15 rounded-full animate-float" style="animation-delay: 2.5s;"></div>

  <div class="relative z-10">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="pt-16 md:pt-20 lg:pt-24 pb-16 lg:pb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 xl:gap-12">
          <div class="lg:col-span-4 xl:col-span-5">
            <a href={`/${lang}`} class="inline-flex items-center gap-4 mb-7 group">
              <img src="/images/logo.ico" alt="AHSAN" class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl shadow-xl shadow-forest/30 group-hover:shadow-gold/10 group-hover:scale-[1.02] transition-all duration-500" />
              <div>
                <span class="block font-heading font-semibold text-xl sm:text-2xl text-white tracking-tight leading-none group-hover:text-gold transition-colors duration-300">AHSAN</span>
                <span class="block text-[10px] sm:text-xs text-transparent bg-clip-text bg-gradient-to-r from-gold to-gold/60 font-semibold tracking-[0.25em] leading-tight uppercase">Premium Services</span>
              </div>
            </a>
            <p class="text-white/25 font-body text-sm leading-relaxed max-w-sm mb-8 tracking-wide">
              {lang === 'de'
                ? 'Premium Immobilienpflege mit kompromissloser Qualität. Wir betreuen Wohnanlagen, Gewerbeimmobilien und Privatkunden in Ahaus und Umgebung.'
                : 'Premium property care with uncompromising quality. Serving residential complexes, commercial properties, and private clients in Ahaus and the surrounding region.'}
            </p>
            <div class="space-y-3 mb-8">
              <p class="text-gold/50 text-[10px] font-body font-medium tracking-[0.2em] uppercase">{t.footer.social}</p>
              <div class="flex items-center gap-3">
                <a
                  href="https://wa.me/4915901313940"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-11 h-11 rounded-xl bg-white/5 border border-white/[0.06] flex items-center justify-center text-white/40 hover:text-gold hover:bg-gold/10 hover:border-gold/20 transition-all duration-400 group"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </a>
                <a
                  href="tel:+4915901313940"
                  class="w-11 h-11 rounded-xl bg-white/5 border border-white/[0.06] flex items-center justify-center text-white/40 hover:text-gold hover:bg-gold/10 hover:border-gold/20 transition-all duration-400 group"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </a>
                <a
                  href={`mailto:info@ahsan-premium.de`}
                  class="w-11 h-11 rounded-xl bg-white/5 border border-white/[0.06] flex items-center justify-center text-white/40 hover:text-gold hover:bg-gold/10 hover:border-gold/20 transition-all duration-400 group"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </a>
              </div>
            </div>
            <p class="font-script text-xl sm:text-2xl text-gold/30 italic leading-relaxed">
              {t.footer.tagline}
            </p>
          </div>

          <div class="lg:col-span-2 xl:col-span-2">
            <h4 class="font-heading font-semibold text-xs sm:text-sm text-gold/60 mb-7 tracking-[0.2em] uppercase">
              {lang === 'de' ? 'Navigation' : 'Navigation'}
            </h4>
            <ul class="space-y-4">
              <li>
                <a href={`/${lang}`} class="text-white/35 hover:text-gold transition-colors duration-300 text-sm sm:text-[15px] font-body tracking-wide">
                  {t.nav.home}
                </a>
              </li>
              <li>
                <a href={`/${lang}#services`} class="text-white/35 hover:text-gold transition-colors duration-300 text-sm sm:text-[15px] font-body tracking-wide">
                  {t.nav.services}
                </a>
              </li>
              <li>
                <a href={`/${lang}#gallery`} class="text-white/35 hover:text-gold transition-colors duration-300 text-sm sm:text-[15px] font-body tracking-wide">
                  {t.nav.gallery}
                </a>
              </li>
              <li>
                <a href={`/${lang}#about`} class="text-white/35 hover:text-gold transition-colors duration-300 text-sm sm:text-[15px] font-body tracking-wide">
                  {t.nav.about}
                </a>
              </li>
              <li>
                <a href={`/${lang}#contact`} class="text-white/35 hover:text-gold transition-colors duration-300 text-sm sm:text-[15px] font-body tracking-wide">
                  {t.nav.contact}
                </a>
              </li>
            </ul>
          </div>

          <div class="lg:col-span-3 xl:col-span-3">
            <h4 class="font-heading font-semibold text-xs sm:text-sm text-gold/60 mb-7 tracking-[0.2em] uppercase">
              {lang === 'de' ? 'Kontakt' : 'Contact'}
            </h4>
            <div class="space-y-5">
              <a href="tel:+4915901313940" class="flex items-center gap-4 text-white/35 hover:text-gold transition-colors duration-300 group">
                <div class="w-11 h-11 bg-white/5 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-gold/10 border border-white/[0.04] group-hover:border-gold/15 transition-all duration-400">
                  <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-white/15 mb-0.5 font-body tracking-wider uppercase">{t.contact.phone}</p>
                  <p class="font-body text-sm font-medium text-white/70 group-hover:text-gold transition-colors duration-300">+49 1590 1313940</p>
                </div>
              </a>
              <a href="https://wa.me/4915901313940" class="flex items-center gap-4 text-white/35 hover:text-gold transition-colors duration-300 group">
                <div class="w-11 h-11 bg-white/5 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-gold/10 border border-white/[0.04] group-hover:border-gold/15 transition-all duration-400">
                  <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-white/15 mb-0.5 font-body tracking-wider uppercase">{t.contact.whatsapp}</p>
                  <p class="font-body text-sm font-medium text-white/70 group-hover:text-gold transition-colors duration-300">+49 1590 1313940</p>
                </div>
              </a>
              <div class="flex items-center gap-4 text-white/35">
                <div class="w-11 h-11 bg-white/5 rounded-xl flex items-center justify-center shrink-0 border border-white/[0.04]">
                  <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-white/15 mb-0.5 font-body tracking-wider uppercase">{lang === 'de' ? 'Standort' : 'Location'}</p>
                  <p class="font-body text-sm font-medium text-white/70">48683 Ahaus</p>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-3 xl:col-span-2">
            <h4 class="font-heading font-semibold text-xs sm:text-sm text-gold/60 mb-7 tracking-[0.2em] uppercase">
              {lang === 'de' ? 'Leistungen' : 'Services'}
            </h4>
            <ul class="space-y-4">
              {t.services.items.slice(0, 5).map((service) => (
                <li>
                  <a href={`/${lang}#services`} class="text-white/35 hover:text-gold transition-colors duration-300 text-sm sm:text-[15px] font-body tracking-wide">
                    {service.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/10 to-transparent"></div>
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="py-8 flex flex-col md:flex-row items-center justify-between gap-5">
          <p class="text-white/20 text-xs sm:text-sm text-center md:text-left font-body tracking-wide">
            &copy; {currentYear} AHSAN. {lang === 'de' ? 'Alle Rechte vorbehalten.' : 'All rights reserved.'}
          </p>
          <div class="flex items-center gap-5">
            <span class="w-1 h-1 bg-gold/30 rounded-full"></span>
            <a href="#" class="text-white/25 hover:text-gold transition-colors duration-300 text-xs sm:text-sm font-body tracking-wide">Impressum</a>
            <span class="w-1 h-1 bg-gold/30 rounded-full"></span>
            <a href="#" class="text-white/25 hover:text-gold transition-colors duration-300 text-xs sm:text-sm font-body tracking-wide">Datenschutz</a>
            <span class="w-1 h-1 bg-gold/30 rounded-full"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
