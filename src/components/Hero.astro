---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative w-full min-h-[70dvh] lg:min-h-screen overflow-hidden" id="hero">
  <div class="absolute inset-0 parallax-bg" id="heroParallax">
    <div class="absolute inset-0 bg-[url('/images/hero-bg3.png')] bg-cover bg-center"></div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-r from-forest/75 via-forest/50 to-transparent"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-forest/50 via-forest/10 to-transparent"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-forest/30 via-transparent to-forest/30"></div>

  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald/[0.04] to-transparent"></div>
  <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-gold/[0.06] rounded-full blur-[150px] animate-glow-pulse"></div>
  <div class="absolute bottom-1/4 right-[10%] w-72 h-72 bg-gold/[0.04] rounded-full blur-[120px] animate-glow-pulse" style="animation-delay: 2s; animation-duration: 5s;"></div>
  <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-white/[0.02] rounded-full blur-[120px]"></div>
  <div class="absolute top-1/3 left-1/2 w-64 h-64 bg-emerald/[0.03] rounded-full blur-[100px]"></div>
  <div class="absolute top-[15%] left-[10%] w-48 h-48 bg-gold/[0.03] rounded-full blur-[100px] animate-float-slow"></div>

  <div class="absolute top-[20%] left-[5%] w-4 h-4 border border-gold/20 rounded-full animate-float" style="animation-delay: 0.5s;"></div>
  <div class="absolute bottom-[30%] right-[8%] w-3 h-3 border border-white/15 rounded-full animate-float" style="animation-delay: 1.5s;"></div>
  <div class="absolute top-[40%] left-[15%] w-2 h-2 bg-gold/20 rounded-full animate-float" style="animation-delay: 2.5s;"></div>

  <div class="absolute inset-0 pointer-events-none after:absolute after:inset-0 after:bg-[url('data:image/svg+xml;base64,')] after:bg-repeat after:bg-[length:300px_300px] after:opacity-50"></div>

  <div class="bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-cream to-transparent absolute z-10"></div>

  <div class="relative z-20 w-full min-h-[70dvh] lg:min-h-screen flex items-center">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-14 w-full pt-24 sm:pt-28 lg:pt-32 pb-16 sm:pb-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-20 items-center">
      <div class="space-y-8 lg:space-y-10">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 bg-white/8 backdrop-blur-md text-white/80 rounded-full border border-white/10">
            <span class="w-1 h-1 bg-gold rounded-full animate-pulse"></span>
            <span class="text-[9px] sm:text-[10px] font-body font-medium tracking-[0.3em] uppercase">{t.hero.tagline}</span>
          </div>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-semibold text-white leading-[0.92] tracking-tight max-w-2xl">
          {t.hero.title}
        </h1>

        <p class="text-sm sm:text-base text-white/40 leading-relaxed max-w-md font-body font-light tracking-wide">
          Comprehensive property care with uncompromising quality and meticulous attention to detail.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a
            href={`/${lang}#contact`}
            class="group inline-flex items-center justify-center gap-2.5 px-6 sm:px-8 lg:px-10 py-3.5 sm:py-4 lg:py-5 bg-gold text-forest font-body font-semibold text-sm sm:text-base rounded-full hover:bg-gold/90 transition-all duration-500 shadow-2xl shadow-gold/25 hover:shadow-gold/40 hover:-translate-y-1 active:scale-[0.97]"
          >
            <span>{t.hero.ctaPrimary}</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href={`https://wa.me/4915901313940?text=${encodeURIComponent(t.whatsapp.message)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-2.5 px-6 sm:px-8 lg:px-10 py-3.5 sm:py-4 lg:py-5 bg-white/8 backdrop-blur-md text-white border border-white/15 font-body font-medium text-sm sm:text-base rounded-full hover:bg-white/15 transition-all duration-500 hover:-translate-y-1 active:scale-[0.97]"
          >
            <svg class="w-4 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>{t.hero.ctaSecondary}</span>
          </a>
        </div>

      </div>

      <div class="hidden lg:block relative">
        <div class="absolute -top-12 -left-12 w-80 h-80 bg-gold/[0.03] rounded-full blur-[120px]"></div>

        <div class="relative space-y-8">
          <div class="glass-card rounded-3xl p-8 animate-float-slow">
            <div class="flex items-center gap-4 mb-5">
              <div class="w-14 h-14 rounded-2xl bg-forest flex items-center justify-center shadow-lg">
                <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <p class="text-forest font-heading font-medium text-lg tracking-tight">Certified Excellence</p>
                <p class="text-charcoal/60 text-sm font-body tracking-wide">Fully licensed & insured</p>
              </div>
            </div>

            <div class="flex -space-x-2.5">
              <div class="w-9 h-9 rounded-full bg-stone border-2 border-white flex items-center justify-center text-[10px] font-bold text-forest">MW</div>
              <div class="w-9 h-9 rounded-full bg-stone border-2 border-white flex items-center justify-center text-[10px] font-bold text-forest">JH</div>
              <div class="w-9 h-9 rounded-full bg-stone border-2 border-white flex items-center justify-center text-[10px] font-bold text-forest">AR</div>
              <div class="w-9 h-9 rounded-full bg-stone border-2 border-white flex items-center justify-center text-[10px] font-bold text-forest">SK</div>
              <div class="w-9 h-9 rounded-full bg-gold border-2 border-white flex items-center justify-center text-[10px] font-bold text-white">+</div>
            </div>
          </div>

          <div class="glass-card rounded-3xl p-8 ml-16 animate-float" style="animation-delay: 1.2s;">
            <div class="flex items-center gap-5">
              <div class="text-5xl font-heading font-bold text-forest">4.9</div>
              <div class="w-px h-12 bg-stone"></div>
              <div>
                <div class="flex gap-0.5 mb-1">
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                </div>
                <p class="text-charcoal/60 text-sm font-body tracking-wide">Average client rating</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30 hidden md:block">
    <a href={`/${lang}#services`} class="group flex flex-col items-center gap-2 text-white/25 hover:text-gold transition-all duration-500">
      <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">Scroll</span>
      <div class="relative w-6 h-10 border-2 border-white/20 rounded-full group-hover:border-gold/40 transition-all duration-500">
        <div class="absolute top-2 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-gold rounded-full animate-[scrollDot_2s_ease-in-out_infinite]"></div>
      </div>
    </a>
  </div>
</section>

<style>
  @keyframes scrollDot {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 1; }
    50% { transform: translateX(-50%) translateY(16px); opacity: 0.3; }
  }
</style>

<script>
  const heroParallax = document.getElementById('heroParallax');
  if (heroParallax) {
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const maxScroll = window.innerHeight;
          const progress = Math.min(scrollY / maxScroll, 0.5);
          heroParallax.style.transform = `translateY(${progress * 60}px) scale(${1 + progress * 0.04})`;
          heroParallax.style.filter = `brightness(${1 - progress * 0.15})`;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
