---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-[100dvh] flex items-center pt-24 pb-12 md:pt-28 md:pb-16 overflow-hidden">
  <div class="absolute inset-0 overflow-hidden">
    <img
      src="/images/hero-bg3.png"
      alt=""
      class="w-full h-full object-cover object-[70%_center] sm:object-center"
      loading="lazy"
    />
  </div>
  <div class="absolute inset-0 bg-gradient-to-br from-bg/40 via-bg/30 to-bg/40"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-bg/60 via-transparent to-bg/30"></div>
  <div class="absolute bottom-0 left-0 w-[30%] h-[50%] bg-gradient-to-tr from-light-green/[0.12] to-transparent"></div>
  <div class="absolute bottom-[10%] left-[5%] w-[20rem] h-[20rem] bg-accent/[0.06] rounded-full blur-[100px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 w-full">
    <div class="max-w-3xl">
      <div class="space-y-7 lg:space-y-9">
        <div class="inline-flex items-center gap-2.5 px-4 py-2 bg-primary/8 text-primary rounded-full border border-primary/10 animate-fade-in-up">
          <span class="w-1.5 h-1.5 bg-primary rounded-full animate-pulse"></span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase">{t.hero.tagline}</span>
        </div>

        <div class="space-y-5 animate-fade-in-up delay-100">
          <div class="flex flex-wrap items-center gap-3">
            <div class="px-5 py-3 sm:px-6 sm:py-3.5 bg-gradient-to-r from-primary to-dark text-white font-heading font-extrabold text-xl sm:text-2xl md:text-3xl rounded-2xl shadow-lg shadow-primary/20">
              AHSAN
            </div>
            <div class="px-5 py-3 sm:px-6 sm:py-3.5 bg-white border-2 border-primary/20 text-primary font-heading font-bold text-base sm:text-lg md:text-xl rounded-2xl shadow-md backdrop-blur-sm">
              HAUSMEISTERSERVICE
            </div>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-heading font-bold text-text leading-[1.08] tracking-tight animate-fade-in-up delay-200">
          <span class="text-gradient-hero">{t.hero.title}</span>
        </h1>

        <p class="text-base sm:text-lg md:text-xl text-text leading-[1.7] max-w-xl animate-fade-in-up delay-300">
          Professionelle Hausmeisterdienstleistungen für Wohnanlagen, Gewerbeimmobilien und Privatkunden. Wir kümmern uns um alles – damit Sie sich entspannen können.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 pt-1 animate-fade-in-up delay-400">
          <a
            href={`/${lang}#contact`}
            class="group inline-flex items-center justify-center gap-2.5 px-8 py-4 sm:px-9 bg-primary text-white font-heading font-semibold text-sm sm:text-[15px] rounded-full hover:bg-dark transition-all duration-300 shadow-xl shadow-primary/25 hover:shadow-2xl hover:shadow-primary/30 hover:-translate-y-0.5 active:scale-[0.97]"
          >
            {t.hero.ctaPrimary}
            <svg class="w-4 h-4 sm:w-[18px] sm:h-[18px] transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href={`https://wa.me/4915901313940?text=${encodeURIComponent(t.whatsapp.message)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-2.5 px-8 py-4 sm:px-9 bg-white border-2 border-primary/15 text-primary font-heading font-semibold text-sm sm:text-[15px] rounded-full hover:bg-primary/5 hover:border-primary/30 transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-[0.97]"
          >
            <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t.hero.ctaSecondary}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-6 pt-2 animate-fade-in-up delay-500">
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 bg-primary/8 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <span class="text-[13px] sm:text-sm font-semibold text-text">Professionell</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 bg-primary/8 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="text-[13px] sm:text-sm font-semibold text-text">Zuverlässig</span>
          </div>
          <div class="flex items-center gap-2.5">
            <div class="w-10 h-10 bg-primary/8 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="text-[13px] sm:text-sm font-semibold text-text">Pünktlich</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce hidden md:block">
    <a href={`/${lang}#services`} class="text-primary/50 hover:text-primary transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
