---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="relative py-16 md:py-20 lg:py-24 bg-white overflow-hidden noise-overlay">
  <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-emerald/[0.02] to-transparent pointer-events-none"></div>
  
  <!-- Optimization: Hide heavy blurs on mobile -->
  <div class="hidden sm:block absolute -top-20 -left-20 w-60 h-60 bg-gold/[0.03] rounded-full blur-[100px]"></div>
  <div class="hidden sm:block absolute -bottom-20 right-[15%] w-72 h-72 bg-emerald/[0.02] rounded-full blur-[120px] animate-float-slow"></div>
  
  <div class="absolute top-[30%] left-[10%] w-3 h-3 border border-gold/20 rounded-full animate-float" style="animation-delay: 1s;"></div>
  <div class="absolute bottom-[20%] right-[5%] w-2 h-2 bg-gold/20 rounded-full animate-float" style="animation-delay: 2s;"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-20 items-center">
      <div class="relative order-2 lg:order-1">
        <div class="relative overflow-hidden rounded-3xl shadow-2xl shadow-forest/20">
          <Image
            src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&fit=crop"
            alt="Premium property care"
            width={700}
            height={850}
            class="w-full h-[400px] lg:h-[500px] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest/40 to-transparent"></div>
        </div>

        <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl shadow-2xl p-6 max-w-[180px]">
          <div class="text-3xl font-heading font-semibold text-forest leading-none mb-1">5+</div>
          <p class="text-[11px] text-muted/60 font-body tracking-wide uppercase">Years of excellence</p>
        </div>

        <div class="absolute -top-4 -left-4 w-24 h-24 bg-gold/10 rounded-full blur-[60px]"></div>
        <div class="absolute -bottom-8 -left-8 w-48 h-48 bg-gold/[0.04] rounded-full blur-[100px] pointer-events-none"></div>
      </div>

      <div class="space-y-8 order-1 lg:order-2">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-forest/5 text-forest/80 rounded-full border border-forest/10">
            <span class="w-1 h-1 bg-gold rounded-full"></span>
            <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">{t.nav.about}</span>
          </div>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-semibold text-charcoal leading-[0.92] tracking-tight">
          Dedicated to <span class="text-gradient">property perfection</span>
        </h2>

        <p class="text-sm sm:text-base text-muted/70 font-body font-light leading-relaxed tracking-wide">
          With over five years of experience serving Ahaus and the surrounding region, we deliver property care that transcends expectations. Our team of skilled professionals brings precision, reliability, and an uncompromising eye for detail to every residence and commercial property we manage.
        </p>

        <div class="grid grid-cols-2 gap-3 pt-4">
          <div class="bg-cream rounded-2xl p-5 border border-stone/50">
            <div class="text-2xl sm:text-3xl font-heading font-semibold text-forest leading-none mb-1">100+</div>
            <p class="text-[11px] text-muted/60 font-body tracking-wide uppercase">Properties served</p>
          </div>
          <div class="bg-cream rounded-2xl p-5 border border-stone/50">
            <div class="text-2xl sm:text-3xl font-heading font-semibold text-forest leading-none mb-1">24/7</div>
            <p class="text-[11px] text-muted/60 font-body tracking-wide uppercase">Rapid response</p>
          </div>
          <div class="bg-cream rounded-2xl p-5 border border-stone/50">
            <div class="text-2xl sm:text-3xl font-heading font-semibold text-forest leading-none mb-1">100%</div>
            <p class="text-[11px] text-muted/60 font-body tracking-wide uppercase">Client satisfaction</p>
          </div>
          <div class="bg-cream rounded-2xl p-5 border border-stone/50">
            <div class="text-2xl sm:text-3xl font-heading font-semibold text-forest leading-none mb-1">&euro;0</div>
            <p class="text-[11px] text-muted/60 font-body tracking-wide uppercase">Hidden fees. Ever.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
