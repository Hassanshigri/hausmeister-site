---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-700" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <nav class="transition-all duration-700 rounded-2xl" id="navInner">
      <div class="flex items-center justify-between h-[64px] lg:h-[72px] px-5 sm:px-7 lg:px-9">
        <a href={`/${lang}`} class="flex items-center gap-3 group shrink-0">
          <img src="/favicon.svg" alt="AHSAN" width="36" height="36" class="w-9 h-9 lg:w-10 lg:h-10 rounded-xl shadow-lg group-hover:shadow-xl transition-all duration-500" />
          <div>
            <span class="nav-logo font-heading font-semibold text-base lg:text-lg tracking-tight leading-none block">AHSAN</span>
            <span class="nav-logo-sub text-[8px] lg:text-[9px] font-semibold tracking-[0.3em] leading-tight block uppercase">Premium Services</span>
          </div>
        </a>

        <div class="hidden lg:flex items-center gap-14">
          <a href={`/${lang}`} class="nav-link font-body font-medium text-sm tracking-wider transition-all duration-300 relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[1.5px] after:bg-gold after:rounded-full after:transition-all hover:after:w-full">{t.nav.home}</a>
          <a href={`/${lang}#services`} class="nav-link font-body font-medium text-sm tracking-wider transition-all duration-300 relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[1.5px] after:bg-gold after:rounded-full after:transition-all hover:after:w-full">{t.nav.services}</a>
          <a href={`/${lang}#gallery`} class="nav-link font-body font-medium text-sm tracking-wider transition-all duration-300 relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[1.5px] after:bg-gold after:rounded-full after:transition-all hover:after:w-full">{t.nav.gallery}</a>
          <a href={`/${lang}#about`} class="nav-link font-body font-medium text-sm tracking-wider transition-all duration-300 relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[1.5px] after:bg-gold after:rounded-full after:transition-all hover:after:w-full">{t.nav.about}</a>
          <a href={`/${lang}#contact`} class="nav-link font-body font-medium text-sm tracking-wider transition-all duration-300 relative after:absolute after:bottom-[-6px] after:left-0 after:w-0 after:h-[1.5px] after:bg-gold after:rounded-full after:transition-all hover:after:w-full">{t.nav.contact}</a>
        </div>

        <div class="flex items-center gap-5">
          <a
            href={lang === 'de' ? '/en' : '/'}
            class="nav-btn flex items-center gap-2 px-4 py-2.5 rounded-xl border transition-all duration-300 text-xs font-body font-semibold group"
            aria-label={lang === 'de' ? 'Switch to English' : 'Wechseln zu Deutsch'}
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-xs font-semibold tracking-wider">{lang === 'de' ? 'EN' : 'DE'}</span>
          </a>

          <a
            href={`https://wa.me/4915901313940?text=${encodeURIComponent(t.whatsapp.message)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:inline-flex items-center gap-2.5 px-6 py-3 bg-forest text-white font-body font-medium text-sm rounded-full hover:bg-dark transition-all duration-500 shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-[0.98]"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Contact</span>
          </a>

          <button
            id="mobile-menu-btn"
            class="nav-btn lg:hidden w-11 h-11 flex items-center justify-center rounded-xl border transition-all duration-300"
            aria-label="Menü öffnen"
          >
            <svg class="w-5 h-5 menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg class="w-5 h-5 close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <div id="mobile-menu" class="lg:hidden hidden fixed inset-0 top-0 z-40 bg-cream/95 backdrop-blur-2xl">
      <div class="flex flex-col h-full pt-32 pb-8 px-6">
        <div class="flex-1 space-y-2">
          <a href={`/${lang}`} class="flex items-center gap-4 px-4 py-4 text-charcoal hover:text-forest hover:bg-forest/5 rounded-2xl font-heading font-semibold text-lg transition-all duration-200">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            {t.nav.home}
          </a>
          <a href={`/${lang}#services`} class="flex items-center gap-4 px-4 py-4 text-charcoal hover:text-forest hover:bg-forest/5 rounded-2xl font-heading font-semibold text-lg transition-all duration-200">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            {t.nav.services}
          </a>
          <a href={`/${lang}#gallery`} class="flex items-center gap-4 px-4 py-4 text-charcoal hover:text-forest hover:bg-forest/5 rounded-2xl font-heading font-semibold text-lg transition-all duration-200">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            {t.nav.gallery}
          </a>
          <a href={`/${lang}#about`} class="flex items-center gap-4 px-4 py-4 text-charcoal hover:text-forest hover:bg-forest/5 rounded-2xl font-heading font-semibold text-lg transition-all duration-200">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {t.nav.about}
          </a>
          <a href={`/${lang}#contact`} class="flex items-center gap-4 px-4 py-4 text-charcoal hover:text-forest hover:bg-forest/5 rounded-2xl font-heading font-semibold text-lg transition-all duration-200">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            {t.nav.contact}
          </a>
        </div>

        <div class="space-y-4 pt-6 border-t border-stone">
          <a
            href={lang === 'de' ? '/en' : '/'}
            class="flex items-center justify-center gap-2.5 w-full px-4 py-3.5 rounded-2xl font-semibold text-sm bg-gold text-white shadow-lg transition-all duration-200"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{lang === 'de' ? 'English' : 'Deutsch'}</span>
          </a>
          <a
            href={`https://wa.me/4915901313940?text=${encodeURIComponent(t.whatsapp.message)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 w-full px-5 py-4 bg-forest text-white font-heading font-semibold text-base rounded-2xl shadow-lg hover:bg-dark transition-all duration-300"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>{t.hero.ctaPrimary}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  #navInner:not(.glass) .nav-logo { color: white; text-shadow: 0 1px 3px rgba(0,0,0,0.3); }
  #navInner:not(.glass) .nav-logo-sub { color: rgba(194,164,109,0.9); text-shadow: 0 1px 2px rgba(0,0,0,0.2); }
  #navInner:not(.glass) .nav-link { color: rgba(255,255,255,0.8); text-shadow: 0 1px 2px rgba(0,0,0,0.2); }
  #navInner:not(.glass) .nav-link:hover { color: white; }
  #navInner:not(.glass) .nav-btn { border-color: rgba(255,255,255,0.3); color: rgba(255,255,255,0.8); }
  #navInner:not(.glass) .nav-btn:hover { background: white; color: #0B3B2E; }

  #navInner.glass .nav-logo { color: #0B3B2E; }
  #navInner.glass .nav-logo-sub { color: #C2A46D; }
  #navInner.glass .nav-link { color: rgba(26,26,26,0.85); }
  #navInner.glass .nav-link:hover { color: #0B3B2E; }
  #navInner.glass .nav-btn { border-color: rgba(194,164,109,0.3); color: #C2A46D; }
  #navInner.glass .nav-btn:hover { background: #C2A46D; color: white; }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const navInner = document.getElementById('navInner');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = mobileMenuBtn?.querySelector('.menu-icon');
  const closeIcon = mobileMenuBtn?.querySelector('.close-icon');

  function updateNavbar() {
    if (window.scrollY > 40) {
      navInner?.classList.add('glass', 'shadow-lg');
    } else {
      navInner?.classList.remove('glass', 'shadow-lg');
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileMenu?.classList.contains('hidden')) {
      mobileMenu?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  });
</script>
