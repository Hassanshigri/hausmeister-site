---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const images = [
  { alt: "Treppenhausreinigung", src: "https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=600&h=450&fit=crop&crop=center" },
  { alt: "Gartenpflege", src: "https://images.unsplash.com/photo-1558904541-efa843a96f01?w=600&h=450&fit=crop&crop=center" },
  { alt: "Winterdienst", src: "https://images.unsplash.com/photo-1491002052546-bf38f186af56?w=600&h=450&fit=crop&crop=center" },
  { alt: "Mülltonnenservice", src: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=450&fit=crop&crop=center" },
  { alt: "Professionelle Werkzeuge", src: "https://images.unsplash.com/photo-1581244273943-6bb5a7d5e4f5?w=600&h=450&fit=crop&crop=center" },
  { alt: "Wohnanlagen", src: "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=600&h=450&fit=crop&crop=center" },
];
---

<section id="gallery" class="relative py-20 md:py-28 lg:py-36 bg-bg">
  <div class="absolute inset-0 bg-gradient-to-b from-white/50 via-transparent to-white/50 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-14 md:mb-18 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-dark/8 text-dark rounded-full border border-dark/10 mb-6">
        <span class="w-1.5 h-1.5 bg-dark rounded-full"></span>
        <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase">{t.gallery.title}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-text leading-[1.1] tracking-tight">
        {t.gallery.subtitle}
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 md:gap-5 lg:gap-6">
      {images.map((img) => (
        <div class="group relative overflow-hidden rounded-2xl aspect-[4/3] cursor-pointer shadow-md hover:shadow-2xl transition-all duration-500">
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-full object-cover transition-all duration-700 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
            <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5 md:p-6">
              <p class="text-white font-heading font-semibold text-xs sm:text-sm md:text-base translate-y-4 group-hover:translate-y-0 transition-all duration-500">
                {img.alt}
              </p>
              <div class="w-8 h-[2px] bg-light-green rounded-full mt-2 translate-y-4 group-hover:translate-y-0 transition-all duration-500 delay-75"></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
