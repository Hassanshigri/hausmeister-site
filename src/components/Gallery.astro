---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const images = [
  { alt: "Entrance & Staircase", src: "https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=600&h=800&fit=crop&crop=center", size: "tall" },
  { alt: "Garden Landscaping", src: "https://images.unsplash.com/photo-1558904541-efa843a96f01?w=600&h=500&fit=crop&crop=center", size: "wide" },
  { alt: "Winter Service", src: "https://images.unsplash.com/photo-1491002052546-bf38f186af56?w=600&h=700&fit=crop&crop=center", size: "tall" },
  { alt: "Property Exteriors", src: "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=600&h=600&fit=crop&crop=center", size: "square" },
  { alt: "Professional Equipment", src: "https://images.unsplash.com/photo-1581244273943-6bb5a7d5e4f5?w=600&h=700&fit=crop&crop=center", size: "tall" },
  { alt: "Waste Management", src: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=500&fit=crop&crop=center", size: "wide" },
];
---

<section id="gallery" class="relative py-24 md:py-32 lg:py-40 bg-dark overflow-hidden">
  <div class="absolute inset-0" style="background-color: #0E3D30;"></div>
  <div class="absolute inset-0 bg-gradient-to-br from-transparent to-black/20 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-48 bg-gradient-to-b from-white/[0.04] to-transparent pointer-events-none"></div>
  <div class="absolute top-1/4 left-[10%] w-72 h-72 bg-gold/[0.04] rounded-full blur-[150px] animate-float-slow"></div>
  <div class="absolute bottom-1/3 right-[10%] w-56 h-56 bg-emerald/[0.03] rounded-full blur-[120px] animate-float" style="animation-delay: 2.5s;"></div>
  <div class="absolute top-1/2 left-1/3 w-48 h-48 bg-white/[0.02] rounded-full blur-[100px] animate-float" style="animation-delay: 4s;"></div>
  <div class="absolute top-[15%] right-[5%] w-3 h-3 border border-gold/20 rounded-full animate-float" style="animation-delay: 1s;"></div>
  <div class="absolute bottom-[20%] left-[8%] w-2 h-2 bg-gold/15 rounded-full animate-float" style="animation-delay: 3s;"></div>

  <div class="absolute inset-0 pointer-events-none after:absolute after:inset-0 after:bg-[url('data:image/svg+xml;base64,')] after:bg-repeat after:bg-[length:300px_300px] after:opacity-50"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto mb-16 md:mb-20 lg:mb-24 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/8 text-white/70 rounded-full border border-white/10 backdrop-blur-sm mb-8">
        <span class="w-1 h-1 bg-gold rounded-full"></span>
        <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">{t.gallery.title}</span>
      </div>
      <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-semibold text-white leading-[0.92] tracking-tight">
        {t.gallery.subtitle}
      </h2>
    </div>

    <div class="columns-1 md:columns-2 lg:columns-3 gap-4 md:gap-5 lg:gap-6 space-y-4 md:space-y-5 lg:space-y-6">
      {images.map((img) => (
        <div class="group relative overflow-hidden rounded-3xl cursor-pointer shadow-lg shadow-black/20 hover:shadow-gold/10 hover:shadow-2xl transition-all duration-700 break-inside-avoid border border-white/[0.04]">
          <div class="absolute inset-0 bg-gradient-to-br from-gold/[0.04] to-transparent opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none z-10"></div>
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-auto object-cover transition-all duration-700 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-forest/80 via-forest/10 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-7 lg:p-8">
              <p class="text-white font-heading font-medium text-sm md:text-base lg:text-lg translate-y-4 group-hover:translate-y-0 transition-all duration-500 tracking-wide">
                {img.alt}
              </p>
              <div class="w-8 h-[2px] bg-gold rounded-full mt-2 translate-y-4 group-hover:translate-y-0 transition-all duration-500 delay-75"></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
