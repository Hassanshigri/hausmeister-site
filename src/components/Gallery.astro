---
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const images = [
  { alt: "Modern Staircase", src: "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?q=80&fit=crop", w: 600, h: 800 },
  { alt: "Bright Garden", src: "https://images.unsplash.com/photo-1516156008625-3a9d6067f522?q=80&fit=crop", w: 600, h: 500 },
  { alt: "Minimalist Exterior", src: "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&fit=crop", w: 600, h: 700 },
  { alt: "Luxury Terrace", src: "https://images.unsplash.com/photo-1558036117-15d82a90b9b1?q=80&fit=crop", w: 600, h: 600 },
  { alt: "Pristine Interiors", src: "https://images.unsplash.com/photo-1613545325278-f24b0cae1224?q=80&fit=crop", w: 600, h: 500 },
];
---

<section id="gallery" class="relative py-24 md:py-32 lg:py-40 bg-dark overflow-hidden">
  <div class="absolute inset-0" style="background-color: #0E3D30;"></div>
  <div class="absolute inset-0 bg-gradient-to-br from-transparent to-black/20 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-48 bg-gradient-to-b from-white/[0.04] to-transparent pointer-events-none"></div>
  
  <!-- Optimization: Hide heavy blurs on mobile -->
  <div class="hidden sm:block absolute top-1/4 left-[10%] w-72 h-72 bg-gold/[0.04] rounded-full blur-[150px] animate-float-slow"></div>
  <div class="hidden sm:block absolute bottom-1/3 right-[10%] w-56 h-56 bg-emerald/[0.03] rounded-full blur-[120px] animate-float" style="animation-delay: 2.5s;"></div>
  <div class="hidden sm:block absolute top-1/2 left-1/3 w-48 h-48 bg-white/[0.02] rounded-full blur-[100px] animate-float" style="animation-delay: 4s;"></div>
  
  <div class="absolute top-[15%] right-[5%] w-3 h-3 border border-gold/20 rounded-full animate-float" style="animation-delay: 1s;"></div>
  <div class="absolute bottom-[20%] left-[8%] w-2 h-2 bg-gold/15 rounded-full animate-float" style="animation-delay: 3s;"></div>



  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="max-w-3xl mx-auto mb-16 md:mb-20 lg:mb-24 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/8 text-white/70 rounded-full border border-white/10 backdrop-blur-sm mb-8">
        <span class="w-1 h-1 bg-gold rounded-full"></span>
        <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">{t.gallery.title}</span>
      </div>
      <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-semibold text-white leading-[0.92] tracking-tight">
        {t.gallery.subtitle}
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5 lg:gap-6">
      {images.map((img) => (
        <div class="group relative overflow-hidden rounded-3xl p-8 bg-white/5 border border-white/10 hover:border-gold/30 transition-all duration-500 text-center">
          <p class="text-white/60 font-heading font-medium text-xs md:text-sm tracking-widest uppercase">
            {img.alt}
          </p>
          <div class="w-8 h-[1px] bg-gold/30 mx-auto mt-4 group-hover:w-12 group-hover:bg-gold transition-all duration-500"></div>
        </div>
      ))}
    </div>
  </div>
</section>
