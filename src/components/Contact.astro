---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="relative py-16 md:py-20 lg:py-24 bg-forest overflow-hidden noise-overlay">

  <div class="absolute top-0 left-0 w-80 h-80 bg-gold/[0.06] rounded-full blur-[150px] animate-glow-pulse-dark"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-white/[0.03] rounded-full blur-[150px]"></div>
  <div class="absolute bottom-[15%] left-[10%] w-48 h-48 bg-gold/[0.03] rounded-full blur-[100px] animate-float-slow" style="animation-delay: 1s;"></div>
  <div class="absolute top-[30%] right-[15%] w-3 h-3 border border-gold/20 rounded-full animate-float" style="animation-delay: 1.5s;"></div>
  <div class="absolute bottom-[40%] left-[5%] w-2 h-2 bg-gold/20 rounded-full animate-float" style="animation-delay: 2.5s;"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-20">
      <div class="text-white space-y-6 lg:space-y-8">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/8 text-white/70 rounded-full border border-white/10 backdrop-blur-sm">
            <span class="w-1 h-1 bg-gold rounded-full"></span>
            <span class="text-[9px] font-body font-medium tracking-[0.3em] uppercase">{lang === 'de' ? 'KONTAKT' : 'CONTACT'}</span>
          </div>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-semibold leading-[0.92] tracking-tight text-white">
          {t.contact.heading}
        </h2>

        <p class="text-white/40 text-sm sm:text-base font-body font-light leading-relaxed max-w-md tracking-wide">
          {lang === 'de'
            ? 'Wir freuen uns auf Ihre Nachricht. Ob telefonisch, per WhatsApp oder vor Ort – wir sind für Sie da.'
            : 'We look forward to hearing from you. By phone, WhatsApp, or in person — we are here for you.'}
        </p>

        <div class="space-y-5">
          <div class="flex items-center gap-4 group">
            <div class="w-12 h-12 sm:w-13 sm:h-13 bg-white/5 backdrop-blur-md rounded-2xl flex items-center justify-center shrink-0 border border-white/5 group-hover:bg-gold/20 group-hover:border-gold/30 transition-all duration-500">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-gold/50 text-xs font-body font-medium mb-0.5">{t.contact.phone}</p>
              <a href="tel:+4915901313940" class="text-white font-heading font-semibold text-lg sm:text-xl md:text-2xl hover:text-gold transition-colors tracking-tight">+49 1590 1313940</a>
            </div>
          </div>

          <div class="flex items-center gap-4 group">
            <div class="w-12 h-12 sm:w-13 sm:h-13 bg-white/5 backdrop-blur-md rounded-2xl flex items-center justify-center shrink-0 border border-white/5 group-hover:bg-gold/20 group-hover:border-gold/30 transition-all duration-500">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="text-gold/50 text-xs font-body font-medium mb-0.5">{t.contact.whatsapp}</p>
              <a href="https://wa.me/4915901313940" class="text-white font-heading font-semibold text-lg sm:text-xl md:text-2xl hover:text-gold transition-colors tracking-tight">+49 1590 1313940</a>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="tel:+4915901313940"
            class="group flex-1 inline-flex items-center justify-center gap-2.5 px-5 sm:px-6 py-3.5 bg-gold text-forest font-body font-semibold text-sm rounded-full hover:bg-gold/90 transition-all duration-500 shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-[0.98]"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {t.contact.callBtn}
          </a>
          <a
            href={`https://wa.me/4915901313940?text=${encodeURIComponent(t.whatsapp.message)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex-1 inline-flex items-center justify-center gap-2.5 px-5 sm:px-6 py-3.5 bg-white/5 backdrop-blur-sm text-white font-body font-medium text-sm rounded-full border border-white/10 hover:bg-white/10 transition-all duration-500 hover:-translate-y-0.5 active:scale-[0.98]"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t.contact.whatsappBtn}
          </a>
        </div>
      </div>

      <div class="bg-white/[0.07] backdrop-blur-xl rounded-3xl p-6 sm:p-8 lg:p-10 border border-white/[0.08] shadow-2xl hover:border-gold/15 hover:shadow-[0_0_60px_rgba(194,164,109,0.06)] transition-all duration-700">
        <div class="flex items-center gap-3 mb-6 sm:mb-8">
          <div class="w-1 h-7 bg-gold rounded-full"></div>
          <h3 class="text-lg sm:text-xl md:text-2xl font-heading font-semibold text-white tracking-tight leading-[0.95]">{t.contact.areaHeading}</h3>
        </div>

        <div class="space-y-4 sm:space-y-5 mb-6 sm:mb-8">
          <div class="group flex items-start gap-3 sm:gap-4 p-3 sm:p-4 -mx-3 sm:-mx-4 rounded-xl hover:bg-white/[0.04] transition-all duration-500 cursor-default">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gold/20 to-gold/5 flex items-center justify-center shrink-0 border border-gold/15 group-hover:border-gold/30 group-hover:from-gold/30 group-hover:to-gold/10 transition-all duration-500">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-medium text-sm sm:text-base tracking-wide">{t.contact.areaText}</p>
              <p class="text-white/35 text-xs font-body mt-0.5">Nordrhein-Westfalen, Germany</p>
            </div>
          </div>
          <div class="group flex items-start gap-3 sm:gap-4 p-3 sm:p-4 -mx-3 sm:-mx-4 rounded-xl hover:bg-white/[0.04] transition-all duration-500 cursor-default">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gold/20 to-gold/5 flex items-center justify-center shrink-0 border border-gold/15 group-hover:border-gold/30 group-hover:from-gold/30 group-hover:to-gold/10 transition-all duration-500">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-medium text-sm sm:text-base tracking-wide">{t.contact.areaNote}</p>
              <p class="text-white/35 text-xs font-body mt-0.5">{lang === 'de' ? 'Auch kurzfristige Einsätze möglich' : 'Short-notice availability'}</p>
            </div>
          </div>
          <div class="group flex items-start gap-3 sm:gap-4 p-3 sm:p-4 -mx-3 sm:-mx-4 rounded-xl hover:bg-white/[0.04] transition-all duration-500 cursor-default">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gold/20 to-gold/5 flex items-center justify-center shrink-0 border border-gold/15 group-hover:border-gold/30 group-hover:from-gold/30 group-hover:to-gold/10 transition-all duration-500">
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-medium text-sm sm:text-base tracking-wide">{lang === 'de' ? 'Zertifiziert & Versichert' : 'Certified & Insured'}</p>
              <p class="text-white/35 text-xs font-body mt-0.5">{lang === 'de' ? 'Vollständig lizenziert und abgesichert' : 'Fully licensed and covered'}</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="absolute left-0 right-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>
          <div class="flex items-center gap-3 pt-4 sm:pt-5">
            <div class="w-8 h-8 rounded-lg bg-gold/10 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-gold animate-float" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-gold/60 text-xs sm:text-sm font-body font-medium tracking-wide">{lang === 'de' ? 'Schnelle Reaktionszeit garantiert' : 'Rapid response guaranteed'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
