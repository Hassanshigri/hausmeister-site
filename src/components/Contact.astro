---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="relative py-20 md:py-28 lg:py-36 bg-gradient-to-br from-dark via-primary to-dark overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg%20width%3D%2280%22%20height%3D%2280%22%20viewBox%3D%220%200%2080%2080%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.5%22%3E%3Cpath%20d%3D%22M50%2050v-8h-4v8h-8v4h8v8h4v-8h8v-4H50z%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3C%2Fsvg%3E');"></div>
  <div class="absolute top-0 left-0 w-64 h-64 bg-light-green/5 rounded-full blur-[120px]"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-white/5 rounded-full blur-[120px]"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-20">
      <div class="text-white space-y-8 lg:space-y-10">
        <div class="space-y-5">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 text-white rounded-full border border-white/10 backdrop-blur-sm">
            <span class="w-1.5 h-1.5 bg-light-green rounded-full animate-pulse"></span>
            <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase">Kontakt aufnehmen</span>
          </div>

          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-heading font-bold leading-[1.08] tracking-tight">
            <span class="text-gradient-light">{t.contact.heading}</span>
          </h2>

          <p class="text-white/60 text-base sm:text-lg leading-relaxed max-w-md">
            Sie haben Fragen oder möchten einen Termin vereinbaren? Wir sind für Sie da!
          </p>
        </div>

        <div class="space-y-6">
          <div class="flex items-center gap-5 group">
            <div class="w-14 h-14 sm:w-16 sm:h-16 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center shrink-0 border border-white/10 group-hover:bg-white/20 transition-all duration-300">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-light-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <p class="text-light-green/60 text-xs sm:text-sm font-medium mb-0.5">{t.contact.phone}</p>
              <a href="tel:+4915901313940" class="text-white font-heading font-bold text-xl sm:text-2xl md:text-3xl hover:text-light-green transition-colors tracking-tight">015901313940</a>
            </div>
          </div>

          <div class="flex items-center gap-5 group">
            <div class="w-14 h-14 sm:w-16 sm:h-16 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center shrink-0 border border-white/10 group-hover:bg-white/20 transition-all duration-300">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-light-green" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="text-light-green/60 text-xs sm:text-sm font-medium mb-0.5">{t.contact.whatsapp}</p>
              <a href="https://wa.me/4915901313940" class="text-white font-heading font-bold text-xl sm:text-2xl md:text-3xl hover:text-light-green transition-colors tracking-tight">015901313940</a>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="tel:+4915901313940"
            class="group flex-1 inline-flex items-center justify-center gap-3 px-6 sm:px-7 py-4 bg-white text-primary font-heading font-semibold text-sm sm:text-[15px] rounded-full hover:bg-light-green hover:text-dark transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-0.5 active:scale-[0.98]"
          >
            <svg class="w-5 h-5 sm:w-[22px] sm:h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {t.contact.callBtn}
          </a>
          <a
            href={`https://wa.me/4915901313940?text=${encodeURIComponent(t.whatsapp.message)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex-1 inline-flex items-center justify-center gap-3 px-6 sm:px-7 py-4 bg-primary/30 backdrop-blur-sm text-white font-heading font-semibold text-sm sm:text-[15px] rounded-full border border-white/20 hover:bg-primary/50 transition-all duration-300 shadow-xl hover:shadow-2xl hover:-translate-y-0.5 active:scale-[0.98]"
          >
            <svg class="w-5 h-5 sm:w-[22px] sm:h-[22px]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {t.contact.whatsappBtn}
          </a>
        </div>
      </div>

      <div class="bg-white/10 backdrop-blur-xl rounded-3xl p-7 sm:p-9 lg:p-11 border border-white/10 shadow-2xl">
        <h3 class="text-xl sm:text-2xl md:text-3xl font-heading font-bold text-white mb-7 sm:mb-9 tracking-tight">{t.contact.areaHeading}</h3>

        <div class="space-y-5 sm:space-y-6 mb-8 sm:mb-10">
          <div class="flex items-start gap-4 sm:gap-5">
            <div class="w-12 h-12 sm:w-13 sm:h-13 bg-light-green/15 rounded-2xl flex items-center justify-center shrink-0 border border-light-green/10">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-light-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-bold text-base sm:text-lg mb-1">{t.contact.areaText}</p>
              <p class="text-white/50 text-sm">Nordrhein-Westfalen, Deutschland</p>
            </div>
          </div>
          <div class="flex items-start gap-4 sm:gap-5">
            <div class="w-12 h-12 sm:w-13 sm:h-13 bg-light-green/15 rounded-2xl flex items-center justify-center shrink-0 border border-light-green/10">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-light-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-bold text-base sm:text-lg mb-1">{t.contact.areaNote}</p>
              <p class="text-white/50 text-sm">Auch kurzfristige Einsätze möglich</p>
            </div>
          </div>
          <div class="flex items-start gap-4 sm:gap-5">
            <div class="w-12 h-12 sm:w-13 sm:h-13 bg-light-green/15 rounded-2xl flex items-center justify-center shrink-0 border border-light-green/10">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-light-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-white font-heading font-bold text-base sm:text-lg mb-1">Zertifiziert & Versichert</p>
              <p class="text-white/50 text-sm">Professionell und abgesichert</p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 text-light-green/80 text-sm sm:text-base bg-white/5 rounded-2xl px-5 py-4 border border-white/5">
          <svg class="w-5 h-5 sm:w-[22px] sm:h-[22px] animate-pulse shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
          </svg>
          <span class="font-semibold">Schnelle Reaktionszeit garantiert</span>
        </div>
      </div>
    </div>
  </div>
</section>
